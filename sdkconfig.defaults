# Default configuration applied on a fresh clone.
#
# IMPORTANT: keep this file ASCII-only. kconfgen parses it with the system
# locale codec, so on a Windows machine running a non-UTF-8 codepage (GBK,
# Shift-JIS, ...) any multibyte character makes the build die with a
# UnicodeDecodeError before compilation even starts.
#
# Your personal settings (Wi-Fi password and friends) belong in sdkconfig,
# which is gitignored. Or just run `idf.py menuconfig`.

# Target chip
CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-DevKitC-1 N16R8 has 16MB of flash.
# Without this IDF assumes 2MB and the partition table will not fit.
# Change both lines together when using a different board.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
